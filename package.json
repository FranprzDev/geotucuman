{
  "name": "geomcp",
  "version": "0.2.0",
  "description": "MCP for discovering and querying public geodata of Argentina",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "xmcp build",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.scripts.json && tsc -p tsconfig.worker.json",
    "catalog": "tsx scripts/build-catalog.ts",
    "validate-catalog": "tsx scripts/validate-catalog.ts",
    "portal": "tsx scripts/build-portal.ts",
    "health": "tsx scripts/health-check.ts",
    "health-page": "tsx scripts/build-health-page.ts",
    "smoke": "tsx scripts/smoke.ts",
    "mcp-smoke": "npm run build && tsx scripts/mcp-smoke.ts",
    "start": "node dist/stdio.js",
    "start:http": "node dist/http.js",
    "worker:dev": "wrangler dev",
    "worker:deploy": "wrangler deploy",
    "worker:smoke": "wrangler deploy --dry-run --outdir .wrangler-dry && node scripts/worker-smoke.mjs",
    "example:focos": "tsx examples/focos-tucuman.ts"
  },
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "xmcp": "^1.9.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@xmcp-dev/compiler": "^1.9.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "wrangler": "^4.160.0"
  }
}
